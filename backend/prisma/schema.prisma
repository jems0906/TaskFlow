generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ActivityType {
  PROJECT_CREATED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_DELETED
  TEAM_CREATED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  memberships   TeamMember[]
  projects      Project[]       @relation("ProjectsCreated")
  createdTasks  Task[]          @relation("TasksCreated")
  assignedTasks Task[]          @relation("TasksAssigned")
  comments      TaskComment[]
  activities    TaskActivity[]  @relation("ActorActivities")
  notifications Notification[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  projects    Project[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id          String         @id @default(cuid())
  teamId      String
  createdById String
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("ProjectsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]
  activities  TaskActivity[]
}

model Task {
  id          String         @id @default(cuid())
  projectId   String
  creatorId   String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus     @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User           @relation("TasksCreated", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("TasksAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  activities  TaskActivity[]
  notifications Notification[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId     String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model TaskActivity {
  id        String       @id @default(cuid())
  projectId String
  taskId    String?
  actorId   String?
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor     User?        @relation("ActorActivities", fields: [actorId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}